# Leave all four empty for a valid NO_LIVE_ADS App Store launch.
# Fill all four with real AdMob production IDs before enabling live rewarded ads.
# App IDs use "~"; ad unit IDs use "/".
# Do not submit builds with placeholder, test, or Google demo AdMob app IDs.
EXPO_PUBLIC_ADMOB_IOS_APP_ID=
EXPO_PUBLIC_ADMOB_ANDROID_APP_ID=
EXPO_PUBLIC_ADMOB_REWARDED_IOS_UNIT_ID=
EXPO_PUBLIC_ADMOB_REWARDED_ANDROID_UNIT_ID=

# Required before pushing App Store metadata with EAS Metadata.
# APP_STORE_BASE_URL is the canonical production value and generates /support and /privacy URLs.
# Marketing, support, and privacy values are optional per-field overrides.
APP_STORE_BASE_URL=
APP_STORE_MARKETING_URL=
APP_STORE_SUPPORT_URL=
APP_STORE_PRIVACY_URL=

# Required before final App Store review submission.
APP_STORE_REVIEW_FIRST_NAME=
APP_STORE_REVIEW_LAST_NAME=
APP_STORE_REVIEW_EMAIL=
APP_STORE_REVIEW_PHONE=

# Set to 1 only after App Store Connect privacy answers match the final build.
APP_STORE_PRIVACY_ANSWERS_REVIEWED=0

# Final manual release confirmations. Set each to 1 only after completing it.
# ADMOB_PRIVACY_MESSAGES_CONFIGURED is required only when all four production AdMob IDs are enabled.
ADMOB_PRIVACY_MESSAGES_CONFIGURED=0
APP_STORE_BUNDLE_ID_CONFIRMED=0
APP_STORE_CONNECT_RECORD_READY=0
EAS_REMOTE_VERSION_INITIALIZED=0
PRODUCTION_DEVICE_TESTED=0
